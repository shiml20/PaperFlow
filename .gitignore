# ============================================================================
# PaperFlow — top-level gitignore
# ============================================================================

# macOS / OS metadata
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# ============================================================================
# Python (backend)
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Virtual environments
.venv/
venv/
env/

# Backend-specific
paperflow/backend/.venv/
paperflow/backend/.pytest_cache/
paperflow/backend/paperflow_backend.egg-info/

# Local user data (PDFs, generated reports, Obsidian vault)
# These are user-owned and may contain copyrighted PDFs — never commit.
data/
paperflow/backend/paperflow_data/
paperflow/paperflow_data/
paperflow_data/

# ============================================================================
# Node / Frontend
# ============================================================================
node_modules/
paperflow/frontend/node_modules/
paperflow/frontend/dist/
paperflow/frontend/tsconfig.tsbuildinfo
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================================
# Build / artifacts
# ============================================================================
build/
dist/
*.log

# ============================================================================
# Environment / secrets
# ============================================================================
.env
.env.*
!.env.example
*.pem
*.key

# ============================================================================
# Vendored sibling project (kept locally, not part of this repo)
# ============================================================================
DeepSeek-TUI/

# ============================================================================
# Internal design docs (kept locally, not part of the open-source repo)
# ============================================================================
design_docs/

# Local PR / launch copy drafts (not part of the open-source repo)
docs/pr-plan.md
docs/launch-copy.md

mytest_script